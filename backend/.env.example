# ============================================================================
# SBKU App - Environment Template (.env.example)
# ============================================================================
# Copy this file to .env and fill in your values.
# IMPORTANT: Never commit .env files with real credentials!
# ============================================================================

# Application
APP_NAME=SBKU
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:YOUR_APP_KEY_HERE  # Generated via 'php artisan key:generate'
APP_URL=https://your-app-name.onrender.com

# Localization
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# ============================================================================
# Database Configuration (Neon PostgreSQL)
# ============================================================================
DB_CONNECTION=pgsql
DB_HOST=your-neon-host.ap-southeast-2.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=your-neon-password
DB_SSLMODE=require
DATABASE_URL="postgresql://your-user:your-password@your-host:5432/your-db?sslmode=require"

# Or use a single Neon connection URL (parsed automatically by start.sh):
# NEON_DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"

# ============================================================================
# Firebase Configuration (Optional)
# ============================================================================
USE_FIRESTORE=false
# FIREBASE_CREDENTIALS=/path/to/firebase-credentials.json
# FIREBASE_PROJECT_ID=your-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-credentials.json

# ============================================================================
# Session & Cache Configuration
# ============================================================================
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=file
CACHE_PREFIX=

# ============================================================================
# Queue & Broadcasting Configuration
# ============================================================================
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log

# ============================================================================
# File Storage Configuration
# ============================================================================
FILESYSTEM_DISK=public

# ============================================================================
# Authentication Configuration
# ============================================================================
AUTH_PROVIDER_DRIVER=eloquent
AUTH_GUARD=sanctum

# ============================================================================
# Email Configuration
# ============================================================================
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================================
# Redis Configuration (Optional - enables redis cache/session if set)
# ============================================================================
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ============================================================================
# Logging Configuration
# ============================================================================
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================================
# Application Configuration
# ============================================================================
BCRYPT_ROUNDS=12
APP_MAINTENANCE_DRIVER=file

# ============================================================================
# Vite Configuration
# ============================================================================
VITE_APP_NAME="${APP_NAME}"
