{
    "family": "default-sbku_app-4b02",
    "executionRoleArn": "arn:aws:iam::617207029940:role/service-role/ecsTaskExecutionRole",
    "networkMode": "awsvpc",
    "requiresCompatibilities": ["FARGATE"],
    "cpu": "1024",
    "memory": "2048",
    "runtimePlatform": {
        "cpuArchitecture": "X86_64",
        "operatingSystemFamily": "LINUX"
    },
    "containerDefinitions": [
        {
            "name": "Main",
            "image": "617207029940.dkr.ecr.ap-southeast-2.amazonaws.com/sbku_app:uat",
            "cpu": 1024,
            "memory": 2048,
            "memoryReservation": 2048,
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 80,
                    "hostPort": 80,
                    "protocol": "tcp"
                }
            ],
            "environment": [],
            "secrets": [],
            "logConfiguration": {
                "logDriver": "awslogs",
                "options": {
                    "awslogs-group": "/aws/ecs/default/sbku_app-4b02-a450",
                    "awslogs-region": "ap-southeast-2",
                    "awslogs-stream-prefix": "ecs"
                }
            }
        }
    ]
}
